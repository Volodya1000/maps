root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
[*.{csproj,props,json,yml}]
indent_size = 2

[*.cs]
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false
dotnet_diagnostic.IDE0044.severity = warning

[*.axaml]
indent_size = 4
