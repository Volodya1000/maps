root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
[*.{csproj,props,json,yml}]
indent_size = 2

[*.cs]
csharp_preserve_single_line_statements = false
# Keep trivial property accessors compact; this does not require collapsing
# unrelated method, control-flow, or lambda blocks.
csharp_preserve_single_line_blocks = true

# Build-enforced correctness and maintainability rules. XML documentation is
# intentionally not enabled: public API documentation is added when useful.
# Unused imports remain visible in IDE/format checks; compiler build does not
# require XML documentation just to report this style diagnostic.
dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.IDE0079.severity = warning
dotnet_diagnostic.IDE0090.severity = warning
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1859.severity = warning
# Contract files intentionally group related records/interfaces; keep this
# maintainability hint visible without requiring artificial file fragmentation.
dotnet_diagnostic.MA0048.severity = suggestion
dotnet_diagnostic.CA1819.severity = suggestion
# These rules produce false positives for ReactiveUI command ownership and
# Avalonia/UI synchronization contexts; the analyzer remains enabled and the
# findings stay visible in IDE/format output.
dotnet_diagnostic.CA1031.severity = suggestion
dotnet_diagnostic.CA1003.severity = suggestion
dotnet_diagnostic.CA1063.severity = suggestion
dotnet_diagnostic.CA1307.severity = suggestion
dotnet_diagnostic.CA1849.severity = suggestion
dotnet_diagnostic.CA1062.severity = suggestion
dotnet_diagnostic.CA2000.severity = suggestion
dotnet_diagnostic.CA2007.severity = suggestion
dotnet_diagnostic.CA2100.severity = suggestion
dotnet_diagnostic.CA2213.severity = suggestion
dotnet_diagnostic.MA0004.severity = suggestion
dotnet_diagnostic.MA0046.severity = suggestion
dotnet_diagnostic.MA0074.severity = suggestion
dotnet_diagnostic.MA0006.severity = suggestion
dotnet_diagnostic.MA0015.severity = suggestion
dotnet_diagnostic.MA0051.severity = suggestion
dotnet_diagnostic.S1172.severity = suggestion
dotnet_diagnostic.S1244.severity = suggestion
dotnet_diagnostic.S3267.severity = suggestion
dotnet_diagnostic.S3358.severity = suggestion
dotnet_diagnostic.S4136.severity = suggestion
dotnet_diagnostic.S3881.severity = suggestion
dotnet_diagnostic.S6608.severity = suggestion
dotnet_diagnostic.S6966.severity = suggestion
dotnet_diagnostic.S927.severity = suggestion
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:error
dotnet_diagnostic.IDE0008.severity = error
csharp_prefer_static_local_function = true:warning
csharp_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_throw_expression = true:warning
csharp_style_coalesce_expression = true:warning
csharp_style_prefer_null_check_over_type_check = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_prefer_simple_using_statement = true:warning
csharp_prefer_braces = true:warning

dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_style_operator_placement_when_wrapping = beginning_of_line:suggestion

dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality = true:warning

[*.axaml]
indent_size = 4
