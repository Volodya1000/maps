<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>by.cablerouteplanner.app</ApplicationId>
    <!-- Monotonically increase this for every distributable APK. -->
    <ApplicationVersion>6</ApplicationVersion>
    <ApplicationDisplayVersion>$(ReleaseVersion)</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidNeedsInternetPermission>false</AndroidNeedsInternetPermission>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CableRoutePlanner.UI/CableRoutePlanner.UI.csproj" />
    <ProjectReference Include="../CableRoutePlanner.Infrastructure/CableRoutePlanner.Infrastructure.csproj" />
    <ProjectReference Include="../CableRoutePlanner.Persistence/CableRoutePlanner.Persistence.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>
  <ItemGroup>
    <AndroidAsset Include="$(GeodataDirectory)/**"
                  Exclude="$(GeodataDirectory)/source*;$(GeodataDirectory)/geodata.sqlite"
                  Link="Data/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(GeodataDirectory)/geodata.sqlite"
                  Condition="Exists('$(GeodataDirectory)/geodata.sqlite') And !Exists('$(GeodataDirectory)/geodata.sqlite.gz')"
                  Link="Data/geodata.sqlite" />
  </ItemGroup>
</Project>
