<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>by.cablerouteplanner.app</ApplicationId>
    <ApplicationVersion>4</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.1</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidNeedsInternetPermission>false</AndroidNeedsInternetPermission>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CableRoutePlanner.Bootstrap/CableRoutePlanner.Bootstrap.csproj" />
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>
  <ItemGroup>
    <AndroidAsset Include="$(GeodataDirectory)/**"
                  Exclude="$(GeodataDirectory)/source*;$(GeodataDirectory)/geodata.sqlite"
                  Link="Data/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(GeodataDirectory)/geodata.sqlite"
                  Condition="Exists('$(GeodataDirectory)/geodata.sqlite') And !Exists('$(GeodataDirectory)/geodata.sqlite.gz')"
                  Link="Data/geodata.sqlite" />
  </ItemGroup>
</Project>
