<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Avalonia compiled XAML warns for DI-only views by design: these views
         are created through TypedViewLocator and have no runtime constructor. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CableRoutePlanner.ViewModels/CableRoutePlanner.ViewModels.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.ReactiveUI" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Mapsui.Avalonia" />
    <PackageReference Include="Mapsui.Nts" />
  </ItemGroup>
</Project>
