<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.map-toolbar">
        <Setter Property="Margin" Value="14" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AppOverlayBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.north-button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="14" />
        <Setter Property="Background" Value="{DynamicResource AppTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="23" />
    </Style>
    <Style Selector="Border.compass-face">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Background" Value="{DynamicResource AppCompassFaceBrush}" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #33000000" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="CornerRadius" Value="23" />
    </Style>
    <Style Selector="Canvas.compass-needle">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
    </Style>
    <Style Selector="Polygon.compass-north">
        <Setter Property="Fill" Value="{DynamicResource AppCompassNorthBrush}" />
    </Style>
    <Style Selector="Polygon.compass-south">
        <Setter Property="Fill" Value="{DynamicResource AppCompassSouthBrush}" />
    </Style>
    <Style Selector="Ellipse.compass-center">
        <Setter Property="Fill" Value="{DynamicResource AppSurfaceBrush}" />
    </Style>
    <Style Selector="Border.map-footer">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="{DynamicResource AppMapFooterBrush}" />
    </Style>
    <Style Selector="TextBlock.map-notice">
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.map-attribution">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.map-side-panel">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Border.map-sheet-handle">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Background" Value="{DynamicResource AppTransparentBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBlock.map-sheet-hint">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.route-divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Background" Value="{DynamicResource AppRouteDividerBrush}" />
    </Style>
    <Style Selector="TextBlock.alternatives-heading">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.route-choice">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Button.route-choice.selected">
        <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppSelectionBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ProgressBar.route-progress">
        <Setter Property="Height" Value="4" />
    </Style>
    <Style Selector="TextBlock.route-choice-name">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.route-choice-length">
        <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="ListBox.route-vertex-list">
        <Setter Property="MaxHeight" Value="220" />
    </Style>
    <Style Selector="Border.route-vertex-row">
        <Setter Property="Padding" Value="5" />
    </Style>
    <Style Selector="Border.route-vertex-row.child">
        <Setter Property="Margin" Value="20,0,0,0" />
    </Style>
    <Style Selector="TextBlock.route-metrics">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.route-vertices-heading">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.route-status">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{DynamicResource AppStatusPanelBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBlock.route-status-text">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource AppStatusTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.vertex-coordinate">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.vertex-select">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource AppTransparentBrush}" />
    </Style>
    <Style Selector="Button.vertex-select.selected">
        <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
    </Style>
    <Style Selector="Border.metric-badge">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.metric-badge.forest">
        <Setter Property="Background" Value="{DynamicResource AppForestBadgeBrush}" />
    </Style>
    <Style Selector="Border.metric-badge.field">
        <Setter Property="Background" Value="{DynamicResource AppFieldBadgeBrush}" />
    </Style>
    <Style Selector="Border.metric-badge.bridge">
        <Setter Property="Background" Value="{DynamicResource AppBridgeBadgeBrush}" />
    </Style>
</Styles>
