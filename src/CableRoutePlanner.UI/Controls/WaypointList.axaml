<rx:ReactiveUserControl
    x:Class="CableRoutePlanner.UI.Controls.WaypointList"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CableRoutePlanner.UI.Controls"
    xmlns:rx="using:Avalonia.ReactiveUI"
    xmlns:vm="using:CableRoutePlanner.ViewModels"
    x:DataType="vm:MapViewModel"
    x:TypeArguments="vm:MapViewModel">
    <rx:ReactiveUserControl.Styles>
        <Style Selector="Border.coordinate">
            <Setter Property="Background" Value="#F1F5F2" />
            <Setter Property="BorderBrush" Value="#DCE5DF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.coordinate.dragging">
            <Setter Property="Background" Value="#DCEEE7" />
            <Setter Property="BoxShadow" Value="0 3 8 0 #50000000" />
        </Style>
        <Style Selector="Border.coordinate.drop-target">
            <Setter Property="BorderBrush" Value="#176B55" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.coordinate.selected">
            <Setter Property="Background" Value="#DBEAFB" />
            <Setter Property="BorderBrush" Value="#1A6FD2" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </rx:ReactiveUserControl.Styles>
    <ItemsControl
        x:Name="Rows"
        ItemsSource="{Binding Points}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WaypointRow">
                <Grid
                    Height="60"
                    Margin="0,0,0,4"
                    ColumnDefinitions="28,*,44">
                    <!--  Slot numbers are outside the dragged coordinate card.  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#6E7C73"
                        Text="{Binding Number}" />
                    <Border
                        x:Name="CoordinateCard"
                        Grid.Column="1"
                        Classes="coordinate"
                        Classes.selected="{Binding IsSelected}"
                        CornerRadius="8"
                        Focusable="True"
                        AutomationProperties.Name="{Binding Display}"
                        KeyDown="RowKeyDown"
                        PointerPressed="RowPressed"
                        PointerExited="RowExited"
                        PointerMoved="DragMoved"
                        PointerReleased="DragReleased"
                        PointerCaptureLost="DragCaptureLost">
                        <Grid ColumnDefinitions="*,44">
                            <TextBlock Margin="4,0" VerticalAlignment="Center"
                                       FontSize="13" Text="{Binding Display}" />
                            <Border
                                x:Name="DragHandle"
                                Grid.Column="1"
                                Background="Transparent"
                                CornerRadius="8"
                                PointerPressed="DragPressed"
                                ToolTip.Tip="Перетащите, чтобы изменить порядок">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="25"
                                    Foreground="#738779"
                                    Text="≡" />
                            </Border>

                        </Grid>
                    </Border>
                    <Button
                        Grid.Column="2"
                        MinWidth="44"
                        MinHeight="48"
                        Padding="0"
                        Background="Transparent"
                        Command="{Binding $parent[local:WaypointList].ViewModel.RemovePoint}"
                        CommandParameter="{Binding Id}"
                        Content="×"
                        FontSize="25"
                        Foreground="#C83D3D"
                        ToolTip.Tip="Удалить точку" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</rx:ReactiveUserControl>
