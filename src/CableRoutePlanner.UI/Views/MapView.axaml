<rx:ReactiveUserControl
    x:Class="CableRoutePlanner.UI.Views.MapView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CableRoutePlanner.UI.Controls"
    xmlns:d="clr-namespace:CableRoutePlanner.Domain;assembly=CableRoutePlanner.Domain"
    xmlns:local="using:CableRoutePlanner.UI.Views"
    xmlns:maps="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
    xmlns:rx="using:Avalonia.ReactiveUI"
    xmlns:vm="using:CableRoutePlanner.ViewModels"
    x:DataType="vm:MapViewModel"
    x:TypeArguments="vm:MapViewModel">
    <Grid
        x:Name="Layout"
        ColumnDefinitions="*,350"
        RowDefinitions="*">
        <Grid
            x:Name="MapArea"
            Grid.Column="0"
            RowDefinitions="*,Auto">
            <maps:MapControl
                x:Name="MapControl"
                Grid.RowSpan="2" />
            <Border
                Classes="map-toolbar"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <ToggleButton
                        Content="Добавлять точки"
                        IsChecked="{Binding AddMode}" />
                    <Button
                        x:Name="ZoomInButton"
                        Content="+" />
                    <Button
                        x:Name="ZoomOutButton"
                        Content="−" />
                </StackPanel>
            </Border>
            <Button
                x:Name="NorthButton"
                Classes="north-button"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                ToolTip.Tip="Вернуть карту к северу"
                AutomationProperties.Name="Вернуть карту к северу">
                <TextBlock
                    x:Name="NorthArrow"
                    Classes="north-arrow"
                    Text="↑" />
            </Button>
            <Border
                Grid.Row="1"
                Classes="map-footer">
                <StackPanel>
                    <TextBlock Classes="map-notice" Text="{Binding MapStatus}" IsVisible="{Binding HasMapNotice}" />
                    <TextBlock
                        x:Name="AttributionCredit"
                        Classes="map-attribution"
                        Text="ⓘ"
                        AutomationProperties.Name="© OpenStreetMap contributors · ODbL 1.0"
                        ToolTip.Tip="© OpenStreetMap contributors · ODbL 1.0" />
                </StackPanel>
            </Border>
        </Grid>
        <Border
            x:Name="SidePanel"
            Classes="map-side-panel"
            Grid.Row="0"
            Grid.Column="1">
            <Grid RowDefinitions="Auto,*">
                <Border
                    x:Name="SheetHandleButton"
                    Classes="map-sheet-handle"
                    Focusable="True">
                    <TextBlock
                        x:Name="SheetHandleText"
                        Classes="map-sheet-hint"
                        HorizontalAlignment="Center"
                        Text="Точки и маршруты · потяните вниз, чтобы свернуть" />
                </Border>
                <ScrollViewer
                    x:Name="SidePanelContent"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock
                        Classes="section-heading"
                        Text="Точки маршрута" />
                    <TextBlock
                        Classes="view-hint"
                        Text="Нажмите на карту. Маркеры можно перетаскивать. При выключенном добавлении карта свободно перемещается. На Desktop вращайте её правой кнопкой мыши; на Android используйте два пальца." />
                    <controls:WaypointList
                        x:Name="WaypointList"
                        DataContext="{Binding}" />
                    <WrapPanel>
                        <Button
                            Command="{Binding CopyCoordinates}"
                            Content="{Binding CopyPointText}" />
                        <Button
                            Command="{Binding ClearPoints}"
                            Content="Очистить" />
                    </WrapPanel>
                    <Expander Header="Ввести координаты">
                        <StackPanel Spacing="6">
                            <TextBox
                                Text="{Binding LatitudeText}"
                                Watermark="Широта, например 53.944" />
                            <TextBox
                                Text="{Binding LongitudeText}"
                                Watermark="Долгота, например 27.502" />
                            <Button
                                Command="{Binding AddManual}"
                                Content="Добавить точку" />
                        </StackPanel>
                    </Expander>
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="primary"
                        Command="{Binding BuildRoutes}"
                        Content="Построить маршруты" />
                    <ProgressBar
                        Height="4"
                        IsIndeterminate="True"
                        IsVisible="{Binding IsBusy}" />
                    <Button
                        Command="{Binding Cancel}"
                        Content="Отменить расчёт"
                        IsVisible="{Binding IsBusy}" />
                    <StackPanel IsVisible="{Binding HasRoute}" Spacing="12">
                        <Border Classes="route-divider" />
                        <TextBlock
                            Classes="alternatives-heading"
                            Text="Альтернативы"
                            IsVisible="{Binding HasAlternatives}" />
                        <ItemsControl
                            x:Name="RouteChoices"
                            ItemsSource="{Binding RouteChoices}"
                            IsVisible="{Binding HasAlternatives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RouteChoice">
                                    <Button
                                        Classes="route-choice"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[local:MapView].ViewModel.ChooseRoute}"
                                        CommandParameter="{Binding Id}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Text="{Binding LengthText}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock
                        Classes="route-metrics"
                        Text="{Binding MetricsText}" />
                    <StackPanel IsVisible="{Binding HasRoute}" Spacing="4">
                        <TextBlock Classes="route-vertices-heading" Text="Точки прокладки кабеля" />
                        <TextBlock Classes="view-hint" Text="Все вершины выбранного маршрута, включая точки изменения направления." />
                        <ListBox MaxHeight="260" ItemsSource="{Binding RouteVertices}" SelectedItem="{Binding SelectedRouteVertex}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RouteVertexRow">
                                    <Border Padding="5" Classes.selected="{Binding IsSelected}">
                                        <Grid ColumnDefinitions="32,*">
                                            <TextBlock Text="{Binding Number}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Display}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Command="{Binding CopyRouteVertex}" Content="{Binding CopyRouteVertexText}" />
                    </StackPanel>
                    <Border Classes="route-status">
                        <TextBlock
                            Classes="route-status-text"
                            Text="{Binding Status}" />
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</rx:ReactiveUserControl>
