<rx:ReactiveUserControl
    x:Class="CableRoutePlanner.UI.Views.MapView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CableRoutePlanner.UI.Controls"
    xmlns:d="clr-namespace:CableRoutePlanner.Domain;assembly=CableRoutePlanner.Domain"
    xmlns:local="using:CableRoutePlanner.UI.Views"
    xmlns:maps="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
    xmlns:rx="using:Avalonia.ReactiveUI"
    xmlns:vm="using:CableRoutePlanner.ViewModels"
    x:DataType="vm:MapViewModel"
    x:TypeArguments="vm:MapViewModel">
    <Grid
        x:Name="Layout"
        ColumnDefinitions="*,350"
        RowDefinitions="*">
        <Grid
            x:Name="MapArea"
            Grid.Column="0"
            RowDefinitions="*,Auto">
            <maps:MapControl
                x:Name="MapControl"
                Grid.RowSpan="2" />
            <Border
                Margin="14"
                Padding="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#EEFFFFFF"
                CornerRadius="8">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <ToggleButton
                        Content="Добавлять точки"
                        IsChecked="{Binding AddMode}" />
                    <Button
                        x:Name="ZoomInButton"
                        Content="+" />
                    <Button
                        x:Name="ZoomOutButton"
                        Content="−" />
                </StackPanel>
            </Border>
            <Border
                Grid.Row="1"
                Padding="10,5"
                Background="#ECFFFFFF">
                <StackPanel>
                    <TextBlock FontSize="11" Text="{Binding MapStatus}" IsVisible="{Binding HasMapNotice}" />
                    <TextBlock
                        x:Name="AttributionCredit"
                        Text="ⓘ"
                        AutomationProperties.Name="© OpenStreetMap contributors · ODbL 1.0"
                        FontSize="13"
                        ToolTip.Tip="© OpenStreetMap contributors · ODbL 1.0" />
                </StackPanel>
            </Border>
        </Grid>
        <Border
            x:Name="SidePanel"
            Grid.Row="0"
            Grid.Column="1"
            Padding="18"
            Background="White"
            BorderBrush="#DFE5E0"
            BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*">
                <Border
                    x:Name="SheetHandleButton"
                    Height="44"
                    Margin="0,0,0,8"
                    Background="Transparent"
                    CornerRadius="8"
                    Focusable="True">
                    <TextBlock
                        x:Name="SheetHandleText"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Text="Точки и маршруты · потяните вниз, чтобы свернуть" />
                </Border>
                <ScrollViewer
                    x:Name="SidePanelContent"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="21"
                        FontWeight="SemiBold"
                        Text="Точки маршрута" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#64726A"
                        Text="Нажмите на карту. Маркеры можно перетаскивать. При выключенном добавлении карта свободно перемещается."
                        TextWrapping="Wrap" />
                    <controls:WaypointList
                        x:Name="WaypointList"
                        DataContext="{Binding}" />
                    <WrapPanel>
                        <Button
                            Command="{Binding CopyCoordinates}"
                            Content="Копировать координаты" />
                        <Button
                            Command="{Binding ClearPoints}"
                            Content="Очистить" />
                    </WrapPanel>
                    <Expander Header="Ввести координаты">
                        <StackPanel Spacing="6">
                            <TextBox
                                Text="{Binding LatitudeText}"
                                Watermark="Широта, например 53.944" />
                            <TextBox
                                Text="{Binding LongitudeText}"
                                Watermark="Долгота, например 27.502" />
                            <Button
                                Command="{Binding AddManual}"
                                Content="Добавить точку" />
                        </StackPanel>
                    </Expander>
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="primary"
                        Command="{Binding BuildRoutes}"
                        Content="Построить маршруты" />
                    <ProgressBar
                        Height="4"
                        IsIndeterminate="True"
                        IsVisible="{Binding IsBusy}" />
                    <Button
                        Command="{Binding Cancel}"
                        Content="Отменить расчёт"
                        IsVisible="{Binding IsBusy}" />
                    <StackPanel IsVisible="{Binding HasRoute}" Spacing="12">
                        <Border
                            Height="1"
                            Margin="0,4"
                            Background="#E5EAE5" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Альтернативы"
                            IsVisible="{Binding HasAlternatives}" />
                        <ItemsControl
                            x:Name="RouteChoices"
                            ItemsSource="{Binding RouteChoices}"
                            IsVisible="{Binding HasAlternatives}">
                            <ItemsControl.Styles>
                                <Style Selector="Button.route-choice">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                </Style>
                                <Style Selector="Button.route-choice.selected">
                                    <Setter Property="Background" Value="#DBEAFB" />
                                    <Setter Property="BorderBrush" Value="#1A6FD2" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RouteChoice">
                                    <Button
                                        Classes="route-choice"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[local:MapView].ViewModel.ChooseRoute}"
                                        CommandParameter="{Binding Id}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Text="{Binding LengthText}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock
                        FontSize="13"
                        LineHeight="21"
                        Text="{Binding MetricsText}"
                        TextWrapping="Wrap" />
                    <Border
                        Padding="8"
                        Background="#EAF2ED"
                        CornerRadius="6">
                        <TextBlock
                            FontSize="13"
                            Foreground="#244D3B"
                            Text="{Binding Status}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</rx:ReactiveUserControl>
