<rx:ReactiveUserControl
    x:Class="CableRoutePlanner.UI.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rx="using:Avalonia.ReactiveUI"
    xmlns:vm="using:CableRoutePlanner.ViewModels"
    x:DataType="vm:SettingsViewModel"
    x:TypeArguments="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel
            MaxWidth="620"
            Margin="28"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <TextBlock
                Classes="settings-title"
                Text="Настройки расчёта" />
            <TextBlock Text="Размер ячейки сетки, м (5–200)" />
            <NumericUpDown
                x:Name="CellSizeInput"
                FormatString="0"
                Maximum="200"
                Minimum="5" />
            <TextBlock Text="Запас кабеля, % (0–100)" />
            <NumericUpDown
                x:Name="ReserveInput"
                FormatString="0.0"
                Maximum="100"
                Minimum="0" />
            <TextBlock
                Text="Мелкая сетка увеличивает время и расход памяти. Для дальних маршрутов шаг автоматически укрупняется в пределах лимита узлов, а затем маршрут проверяется по исходным геометриям. Высоты и уклоны не учитываются без DEM."
                TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding PreferOverheadGasCrossings}">
                <TextBlock Text="Предпочитать воздушные переходы газопроводов (кандидаты)" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="Только по размеченной оси перехода. Пригодность крепления и разрешение владельца не подтверждены." TextWrapping="Wrap" />
            <Button
                Classes="primary"
                Command="{Binding Save}"
                Content="Сохранить"
                IsVisible="{Binding CanSave}" />
            <Button
                Command="{Binding ResetDefaults}"
                Content="Сбросить настройки"
                IsVisible="{Binding CanReset}" />
            <TextBlock
                Text="{Binding Status}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</rx:ReactiveUserControl>
