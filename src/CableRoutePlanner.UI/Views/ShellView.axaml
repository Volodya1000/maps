<rx:ReactiveUserControl
    x:Class="CableRoutePlanner.UI.Views.ShellView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rx="using:Avalonia.ReactiveUI"
    xmlns:vm="using:CableRoutePlanner.ViewModels"
    x:DataType="vm:ShellViewModel"
    x:TypeArguments="vm:ShellViewModel">
    <Grid
        Background="#F5F7F5"
        RowDefinitions="Auto,Auto,*">
        <Border
            Padding="16,12"
            Background="White"
            BorderBrush="#DFE5E0"
            BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,20,8"
                    FontSize="21"
                    FontWeight="SemiBold"
                    Text="Кабельные маршруты" />
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <ToggleButton
                        Command="{Binding ShowMap}"
                        Content="Карта"
                        IsChecked="{Binding IsMap, Mode=OneWay}" />
                    <ToggleButton
                        Command="{Binding ShowSettings}"
                        Content="Настройки"
                        IsChecked="{Binding IsSettings, Mode=OneWay}" />
                </StackPanel>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Padding="16" Background="#FFF1D6"
                IsVisible="{Binding ShowUnsavedWarning}">
            <StackPanel Spacing="8">
                <TextBlock Text="Есть несохранённые изменения настроек. Остаться и сохранить их или уйти без сохранения?"
                           TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Content="Остаться" Command="{Binding StayOnSettings}" />
                    <Button Content="Уйти без сохранения" Command="{Binding DiscardAndLeave}" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <rx:RoutedViewHost
            x:Name="RouteHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            PageTransition="{x:Null}"
            Router="{Binding Router}" />
    </Grid>
</rx:ReactiveUserControl>
