<rx:ReactiveUserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:rx="using:Avalonia.ReactiveUI" xmlns:vm="using:CableRoutePlanner.ViewModels" x:Class="CableRoutePlanner.UI.Views.AboutView" x:TypeArguments="vm:AboutViewModel" x:DataType="vm:AboutViewModel">
<ScrollViewer><StackPanel MaxWidth="700" HorizontalAlignment="Stretch" Margin="28" Spacing="18"><TextBlock Text="Картографические данные" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Region}" FontSize="20"/><TextBlock Text="{Binding Attribution}"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap" LineHeight="24"/></StackPanel></ScrollViewer></rx:ReactiveUserControl>
