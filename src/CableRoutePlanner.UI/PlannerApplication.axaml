<Application
    x:Class="CableRoutePlanner.UI.PlannerApplication"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CableRoutePlanner.UI/Resources/Brushes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://CableRoutePlanner.UI/Styles/Common.axaml" />
        <StyleInclude Source="avares://CableRoutePlanner.UI/Styles/Shell.axaml" />
        <StyleInclude Source="avares://CableRoutePlanner.UI/Styles/Map.axaml" />
        <StyleInclude Source="avares://CableRoutePlanner.UI/Styles/WaypointList.axaml" />
    </Application.Styles>
</Application>
