<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CableRoutePlanner.UI/CableRoutePlanner.UI.csproj" />
    <ProjectReference Include="../CableRoutePlanner.Infrastructure/CableRoutePlanner.Infrastructure.csproj" />
    <ProjectReference Include="../CableRoutePlanner.Persistence/CableRoutePlanner.Persistence.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(GeodataDirectory)/**" Exclude="$(GeodataDirectory)/geodata.sqlite.gz;$(GeodataDirectory)/source*" Link="Data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
